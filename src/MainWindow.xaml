<Window x:Class="ThinQDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="Assets/clima.png" Title="Clima • ThinQ Desktop" Width="1180" Height="900" MinWidth="1020" MinHeight="770" Background="#0C1220" Foreground="#F3F6FC" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#91A2BB"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F6FC"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9EFFA"/><Setter Property="Background" Value="#23324B"/><Setter Property="BorderBrush" Value="#344562"/>
   <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.32"/><Setter Property="Cursor" Value="Arrow"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#172238"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="35"/></Style>
 </Window.Resources>
 <Grid Margin="32,24,32,20">
  <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Border Background="#193A48" CornerRadius="14" Width="46" Height="46"><TextBlock Text="❄" FontSize="29" Foreground="#77E4EE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="clima" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="SEU ESPAÇO, DO SEU JEITO" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border Background="#182639" CornerRadius="12" Padding="12,10" Margin="0,0,10,0"><TextBlock x:Name="ConnectionLabel" Text="●  Conectando" Foreground="#8BE2C3"/></Border><Button Content="↻  Atualizar" x:Name="RefreshButton" Click="RefreshClick" Margin="0,0,8,0"/><Button Content="⚙" ToolTip="Conexão e aparelho" Click="SettingsClick" x:Name="SettingsButton" FontSize="18" Padding="14,8"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="DeviceName" Text="Seu ar-condicionado" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,5"/>
    <TextBlock Text="LG Dual Inverter · painel de ambiente" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
    <Border CornerRadius="24" Padding="26" Height="214">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#143B50" Offset="0"/><GradientStop Color="#192A41" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid>
      <StackPanel><TextBlock Text="TEMPERATURA AMBIENTE" FontSize="11" Foreground="#95D7E2"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="AmbientValue" Text="—" FontSize="60" FontWeight="Light" Foreground="#93EDF2"/><TextBlock Text="°C" FontSize="30" Foreground="#61B9C5" Margin="6,19,0,0"/></StackPanel><TextBlock x:Name="ModeSummary" Text="Aguardando leitura do aparelho" Foreground="#BADAE2"/><Border Background="#1E4A59" CornerRadius="10" Padding="10,6" HorizontalAlignment="Left" Margin="0,17,0,0"><TextBlock x:Name="HealthValue" Text="Estado não consultado" FontSize="12" Foreground="#B6F4DE"/></Border></StackPanel>
      <Canvas Width="170" Height="125" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.8">
       <Border Canvas.Top="3" Width="166" Height="62" CornerRadius="13" Background="#D7E8ED" BorderBrush="#F3FFFF" BorderThickness="1"/>
       <Border x:Name="MainAirVane" Canvas.Top="42" Canvas.Left="10" Width="146" Height="9" CornerRadius="4" Background="#7494A8"/>
       <Ellipse Canvas.Left="143" Canvas.Top="19" Width="5" Height="5" Fill="#30D5BD"/>
       <Path x:Name="MainAirStream" Stroke="#61C8D5" StrokeThickness="2" Data="M 35,75 C 20,87 49,99 33,113 M 81,75 C 66,87 95,99 79,119 M 128,75 C 113,87 142,99 126,113"/>
      </Canvas>
     </Grid>
    </Border>
    <UniformGrid Columns="3" Margin="0,16,0,0">
     <Border CornerRadius="18" Background="#302A24" Padding="18" Margin="0,0,9,0"><StackPanel><TextBlock Text="DESEJADA" Foreground="#DCB990" FontSize="10"/><TextBlock x:Name="TargetCard" Text="— °C" FontSize="28" Foreground="#FFCA85" Margin="0,8,0,8"/><TextBlock Text="Ajuste do aparelho" FontSize="11" Foreground="#B9A795"/></StackPanel></Border>
     <Border CornerRadius="18" Background="#28253E" Padding="18" Margin="0,0,9,0"><StackPanel><TextBlock Text="VENTILAÇÃO" Foreground="#B8A5E5" FontSize="10"/><TextBlock x:Name="FanCard" Cursor="Hand" MouseLeftButtonUp="FanCardClick" ToolTip="Regular a velocidade no gráfico" Text="—" FontSize="28" Foreground="#C7ACFF" Margin="0,8,0,8"/><TextBlock x:Name="FanStep" Text="Sem leitura" FontSize="11" Foreground="#ADA2C6"/></StackPanel></Border>
     <Border CornerRadius="18" Background="#19352F" Padding="18"><StackPanel><TextBlock Text="OSCILAÇÃO" Foreground="#8FCBB5" FontSize="10"/><TextBlock x:Name="SwingCard" Cursor="Hand" MouseLeftButtonUp="FlowCardClick" ToolTip="Abrir o ajuste visual do fluxo" Text="—" FontSize="28" Foreground="#8CE3BA" Margin="0,8,0,8"/><TextBlock Text="Direção vertical" FontSize="11" Foreground="#9ABCAC"/></StackPanel></Border>
    </UniformGrid>
    <Border Background="#151F30" CornerRadius="18" Padding="20" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Filtro e manutenção" FontWeight="SemiBold"/><TextBlock x:Name="FilterValue" Text="Aguardando contadores do aparelho" Margin="0,7,0,0" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><Border Grid.Column="1" Background="#27344A" CornerRadius="10" Padding="12,8" VerticalAlignment="Center"><TextBlock x:Name="LightValue" Text="Display · —" FontSize="12" Foreground="#CCD7E9"/></Border></Grid></Border>
    <Button Content="Ver todos os dados do aparelho   ↗" Click="DiagnosticsClick" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Foreground="#91A2BB" Padding="0,12"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Column="2" Background="#DCE1E5" CornerRadius="34" BorderBrush="#F2F5F6" BorderThickness="2" Padding="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid><StackPanel><TextBlock Text="CONTROLE" FontSize="11" Foreground="#536577"/><TextBlock Text="Controle remoto" Foreground="#253748" FontSize="22" Margin="0,5,0,0"/></StackPanel><Button x:Name="PowerButton" Content="⏻" FontSize="27" Width="56" Height="56" Padding="0" HorizontalAlignment="Right" Background="#28463F" Foreground="#9CEDC5" BorderBrush="#386A58" Click="PowerClick" ToolTip="Ligar ou desligar"/></Grid>
     <TextBlock x:Name="PowerLabel" Text="Sem leitura" Foreground="#536577" Margin="0,8,0,10"/>
     <Border Background="#BECBBE" CornerRadius="14" Padding="8"><StackPanel><TextBlock Text="TEMPERATURA DESEJADA" Foreground="#4C6250" FontSize="10" HorizontalAlignment="Center"/><TextBlock x:Name="RemoteTarget" Text="—°" FontSize="34" FontWeight="Light" Foreground="#263F2E" HorizontalAlignment="Center" Margin="0,1,0,2"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="MinusButton" Content="−" FontSize="25" Padding="8,3" Click="MinusClick" ToolTip="Diminuir temperatura"/><Button x:Name="PlusButton" Grid.Column="2" Content="+" FontSize="25" Padding="8,3" Click="PlusClick" ToolTip="Aumentar temperatura"/></Grid><TextBlock x:Name="RangeLabel" Text="Limites definidos pelo aparelho" Foreground="#4C6250" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
     <TextBlock Text="MODO" Foreground="#536577" FontSize="10" Margin="0,20,0,9"/><UniformGrid x:Name="ModesPanel" Columns="3"/>
     <TextBlock Text="VELOCIDADE DA VENTILAÇÃO" Foreground="#536577" FontSize="10" Margin="0,12,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Button x:Name="FanMinusButton" Content="−" Click="FanMinusClick" FontSize="22" Padding="0,4"/><Button x:Name="FanSettingsButton" Grid.Column="1" Content="—" Click="FanSettingsClick" Margin="6,0" Padding="4,8" ToolTip="Abrir gráfico de ventilação"/><Button x:Name="FanPlusButton" Grid.Column="2" Content="+" Click="FanPlusClick" FontSize="22" Padding="0,4"/></Grid>
     <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SwingButton" Content="Fluxo de ar ↗" Click="FlowSettingsClick" Padding="8,12"/><Button x:Name="LightButton" Grid.Column="2" Content="☼  Display" Click="LightClick" Padding="8,12"/></Grid>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="TimerButton" Content="◷  Timer" Click="TimerClick" Padding="6,10" FontSize="12"/><Button x:Name="SleepButton" Grid.Column="2" Content="☾  Sleep" Click="SleepClick" Padding="6,10" FontSize="12"/></Grid><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="AI Care" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Não disponível na conexão atual com a LG." Padding="6,10"/><Button Grid.Column="2" Content="Jet Mode" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Não disponível na conexão atual com a LG." Padding="6,10"/></Grid><Button x:Name="FlowSettingsButton" Content="Fluxo de ar · ajuste visual ↗" Click="FlowSettingsClick" Visibility="Collapsed"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Recuperando sua conexão salva…" Foreground="#9AAEC8" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock x:Name="UpdatedText" Grid.Column="1" Text="" Foreground="#7285A1" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
 </Grid>
</Window>






